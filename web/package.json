{
  "name": "@pulso/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build -o storybook-static --disable-telemetry"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.108.2",
    "storybook": "^8.6.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "react": "19",
    "react-dom": "19",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "zustand": "^5.1.0"
  }
}
